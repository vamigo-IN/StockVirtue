# ── StockVirtue website (stockvirtue.com) ───────────────────────────────────
# Copy to `.env.local` for dev / set as real env on the server. NEVER commit
# the filled-in file — SITE_ADMIN_KEY is a secret.

# Public canonical site URL (used for SEO canonical/OG/sitemap).
NEXT_PUBLIC_SITE_URL=https://stockvirtue.com

# Google Play listing for the Android app.
NEXT_PUBLIC_PLAY_URL=https://play.google.com/store/apps/details?id=com.vamigo.stockvirtue

# Existing backend (server-side only — the browser never calls it directly).
API_BASE=https://api.stockvirtue.com

# Server-to-server key the Next.js server sends with every newsroom-portal call
# (/admin). Must match SITE_ADMIN_KEY in the backend env; the portal refuses to
# work without it. Staff sign in with their own accounts (no shared password).
SITE_ADMIN_KEY=CHANGE_ME
