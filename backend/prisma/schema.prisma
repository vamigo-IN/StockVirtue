// StockVirtue backend — Prisma schema
// Edit and run `npx prisma migrate dev --name <change>` to evolve the DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

/// Backend dashboard operator. Completely separate from [User] — admins
/// don't trade, don't carry watchlists, don't show up in leaderboards.
/// Auth is email + password (scrypt-hashed) plus a signed session cookie,
/// not the phone-OTP flow normal users go through. Boot-time seed from
/// ADMIN_EMAIL / ADMIN_PASSWORD env vars; rotate by updating env + restart.
model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  @@map("admins")
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP_LOSS // SL-M: triggers a market fill when price crosses triggerPriceP
  STOP_LOSS_LIMIT // SL-L: trigger flips the order into a regular pending LIMIT
  TRAILING_STOP // SELL only — trigger ratchets up with LTP, fires on retracement
}

enum OrderStatus {
  PENDING
  FILLED
  CANCELLED
  REJECTED
}

enum OrderProduct {
  DELIVERY // CNC: T+1, full STT both sides, no brokerage
  INTRADAY // MIS: square-off same day, lower STT, brokerage applies. TODO: auto-square.
}

/// Where an order came from. USER orders are cancellable while PENDING;
/// system-generated square-off / settlement orders are not — they always
/// fill immediately and must never be shown a Cancel action.
enum OrderOrigin {
  USER
  AUTO_SQUARE // intraday (MIS) end-of-day square-off
  EXPIRY // F&O expiry-day settlement
}

/// Admin-toggleable feature flags. Currently gates which auth methods the
/// mobile app offers — e.g. pausing Mobile OTP login. The public
/// /auth/config endpoint reads these; the admin panel writes them. Rows are
/// seeded with sane defaults on boot, so a missing row reads as its default.
model FeatureFlag {
  key       String   @id
  enabled   Boolean
  label     String?
  updatedAt DateTime @default(now()) @updatedAt

  @@map("feature_flags")
}

/// Append-only log of privileged admin actions, for accountability. Written
/// by the admin panel on every state-changing operation (block/unblock,
/// feature-flag toggle, snapshot run, login). Never updated or deleted.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  adminEmail String
  action     String // e.g. 'user.block', 'flag.set', 'snapshot.run', 'login'
  target     String? // affected entity id (userId, flag key, …)
  detail     String? // freeform extra context
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("admin_audit_logs")
}

/// Delivery state of the login-verification email. The send happens in the
/// background so the operator isn't held on the login page waiting for SMTP;
/// the verification screen polls this to show whether it actually went out.
enum AdminEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Lifecycle of a single admin login ATTEMPT.
enum AdminLoginStatus {
  PENDING /// password accepted; awaiting OTP + passcode
  OTP_SENT /// transformed OTP emailed
  VERIFIED /// BOTH factors verified; awaiting session issue
  SUCCESS /// session issued
  FAILED /// attempts exhausted / bad credentials
  LOCKED /// device or IP blocked mid-flow
  EXPIRED /// OTP / passcode window elapsed
  TERMINATED /// superseded by a newer attempt, or killed
}

/// One row per admin login attempt ("Login Session" in Admin Shield terms).
/// Holds the single-use OTP + passcode as scrypt hashes (never plaintext, and
/// the transformed/emailed OTP is never stored at all), the device + network
/// context captured when the attempt started, and per-factor attempt counters.
///
/// Deliberately carries no FK to `admins` — same precedent as admin_audit_logs
/// — so the forensic record survives an admin row being rotated.
model AdminLoginSession {
  id      String  @id @default(cuid())
  adminId String?
  email   String

  /// scrypt hash of the REAL otp (the emailed, transformed value is never stored)
  otpHash            String?
  otpExpiresAt       DateTime?
  otpVerifiedAt      DateTime?
  otpAttempts        Int       @default(0)
  otpResends         Int       @default(0)
  /// Whether the verification email actually reached SMTP. Surfaced on the
  /// verification screen so a silent mail failure is visible rather than
  /// looking like a code that never arrives.
  otpEmailStatus     AdminEmailStatus @default(PENDING)
  otpEmailAt         DateTime?
  passcodeHash       String?
  passcodeExpiresAt  DateTime?
  passcodeVerifiedAt DateTime?
  passcodeAttempts   Int       @default(0)
  passcodeResends    Int       @default(0)
  passwordAttempts   Int       @default(0)

  ip          String?
  userAgent   String?
  browser     String?
  os          String?
  device      String?
  fingerprint String?
  timezone    String?
  /// Populated only if an IP-geolocation provider is configured; null otherwise.
  country     String?
  city        String?
  isp         String?

  status           AdminLoginStatus @default(PENDING)
  terminatedReason String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime
  succeededAt DateTime?

  @@index([email, createdAt])
  @@index([fingerprint])
  @@index([status])
  @@map("admin_login_sessions")
}

/// An ACTIVE authenticated admin session. The auth cookie carries this row's
/// id, which is what makes a session revocable server-side — required for
/// "one active session only", idle/absolute timeout, and hijack detection.
/// (The previous cookie was stateless, so nothing could be terminated.)
model AdminSession {
  id             String    @id @default(cuid())
  adminId        String
  loginSessionId String?
  fingerprint    String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?

  @@index([adminId, revokedAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Device-fingerprint reputation + blocking. Admin Shield never locks the
/// admin ACCOUNT (that would be a trivial self-DoS); it blocks the offending
/// device fingerprint instead.
model AdminDevice {
  id             String    @id @default(cuid())
  fingerprint    String    @unique
  label          String?
  lastIp         String?
  lastUserAgent  String?
  failedSessions Int       @default(0)
  blockedUntil   DateTime?
  blockReason    String?
  trusted        Boolean   @default(false)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())

  @@index([blockedUntil])
  @@map("admin_devices")
}

// ─── Traffic monitoring & data-misuse detection ─────────────────────────────

enum AbuseSubjectType {
  IP
  USER
}

enum AbuseStatus {
  OPEN
  ACKNOWLEDGED
  IGNORED
  ACTIONED
}

/// Aggregated request traffic, one row per (minute bucket, method, route,
/// status class). Flushed from Redis every 60s; backs the admin traffic charts
/// and top-endpoints table without ever writing a row per request.
model TrafficStat {
  id           String   @id @default(cuid())
  bucket       DateTime // start of the 1-minute window (UTC)
  method       String
  route        String // route template, e.g. '/api/market/quote/:symbol'
  statusClass  Int // 2 | 3 | 4 | 5
  count        Int
  errorCount   Int
  latencySumMs BigInt // avg = latencySumMs / count
  latencyMaxMs Int
  createdAt    DateTime @default(now())

  @@unique([bucket, method, route, statusClass])
  @@index([bucket])
  @@map("traffic_stats")
}

/// One detected abuse / data-misuse event per (kind, subject) per de-dupe
/// window (deduped in Redis so it can't spam). Surfaced on the admin panel.
model AbuseEvent {
  id          String           @id @default(cuid())
  kind        String // 'rate.ip' | 'authfail.ip' | 'order.spam' | 'market.scrape' | 'signup.multi' | 'data.harvest' | …
  subjectType AbuseSubjectType
  subject     String // the IP or userId
  severity    Int              @default(1) // 1..3
  count       Int
  threshold   Int
  windowSec   Int
  detail      String?
  ip          String?
  userId      String?
  status      AbuseStatus      @default(OPEN)
  autoAction  String? // 'blocked' | 'throttled' | null
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([subjectType, subject, createdAt])
  @@map("abuse_events")
}

/// Sampled + high-signal raw request log for forensic drill-down (NOT every
/// request — sampled 2xx + always errors/flagged). Pruned on a retention timer.
model RequestLog {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  method    String
  route     String
  status    Int
  latencyMs Int
  userId    String?
  ip        String?
  userAgent String?
  requestId String?
  flagged   Boolean  @default(false)

  @@index([ts])
  @@index([userId, ts])
  @@index([ip, ts])
  @@map("request_logs")
}

model User {
  id          String     @id @default(cuid())
  phone       String?    @unique
  displayName String?
  emailAlias  String?    @unique
  firebaseUid String?    @unique
  /// scrypt hash for server-side email/password accounts (PHC-ish format,
  /// same scheme as Admin). Null for Firebase-only users (Google/phone).
  passwordHash String?
  /// True once the email/password user has confirmed ownership via the
  /// emailed OTP. Firebase identities (Google) are considered verified by
  /// the provider and set this true on creation.
  emailVerified Boolean  @default(false)
  /// Profile photo URL from a federated provider (e.g. Google `picture`
  /// claim). Backfilled on each sign-in; null for users without one.
  avatarUrl   String?
  /// Opt-in for a per-trade email on every order fill. Default OFF — an active
  /// user fills many orders/day, so this would be spammy on by default.
  /// High-signal emails (referral redeemed, password reset) are always sent.
  tradeEmailsOptIn Boolean @default(false)
  /// Set the first time achievements are evaluated for this account. New
  /// accounts get it stamped at creation (so their genuine first unlock
  /// notifies). Existing accounts are null until their first evaluation,
  /// which silently snapshots historical unlocks instead of spamming push/
  /// email — see AchievementsService.evaluate.
  achievementsBaselinedAt DateTime?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastLoginAt DateTime?
  /// Public invite code — same FNV-1a hash the client used to display
  /// before the redemption flow shipped, so codes already in the wild
  /// keep working. Nullable for backfill safety; new users always get
  /// one populated at creation time.
  referralCode String?  @unique
  /// FK to the user whose code I redeemed. Set once on successful
  /// redemption and never changed. Each user can redeem at most one
  /// code in their lifetime.
  referredById String?

  watchlists Watchlist[]
  wallet     Wallet?
  orders     Order[]
  positions  Position[]
  leaderboard LeaderboardEntry?
  deviceTokens DeviceToken[]
  priceAlerts  PriceAlert[]
  notifications Notification[]
  portfolioSnapshots PortfolioSnapshot[]
  ownedRooms      Room[]       @relation("RoomOwner")
  roomMemberships RoomMember[]
  walletCredits   WalletCredit[]
  referredBy      User?        @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]       @relation("UserReferrals")
  achievements    UserAchievement[]
  lessonProgress  LessonProgress[]
  quizAttempts    QuizAttempt[]
  /// Present only for newsroom staff (see StaffProfile).
  staffProfile    StaffProfile?
  roles           UserRole[]

  @@index([phone])
  @@index([referredById])
  @@map("users")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String // 'android' | 'ios' | 'web'
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// Server-owned notification inbox. Every notification we surface (order fills,
/// price alerts, achievements, market-close reminders, admin broadcasts) is
/// stored here so the app can fetch its history and unread count. Real-time
/// delivery rides the Socket.IO connection; FCM handles background delivery.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    @default("info") // info | order | price | achievement | reminder | admin
  title     String
  body      String
  data      Json? // optional deep-link payload (e.g. { symbol })
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

enum AlertCondition {
  ABOVE
  BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

model PriceAlert {
  id            String         @id @default(cuid())
  userId        String
  symbol        String
  tradingsymbol String
  symboltoken   String
  exchange      String
  condition     AlertCondition
  priceP        BigInt
  status        AlertStatus    @default(ACTIVE)
  note          String?
  createdAt     DateTime       @default(now())
  triggeredAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, symboltoken, exchange])
  @@map("price_alerts")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([userId, name])
  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id            String   @id @default(cuid())
  watchlistId   String
  symbol        String
  tradingsymbol String
  symboltoken   String
  exchange      String
  position      Int      @default(0)
  addedAt       DateTime @default(now())

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symboltoken, exchange])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// All money stored as BigInt paise (1 INR = 100 paise) to avoid float drift.
// API responses convert to rupees (number) at the boundary.

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  balanceP        BigInt   @default(100000000) // ₹10,00,000 starting balance
  reservedP       BigInt   @default(0) // cash locked by PENDING buy-limit orders
  marginReservedP BigInt   @default(0) // margin locked by open F&O short positions
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

/// Why non-trading money entered a wallet.
enum WalletCreditKind {
  REFERRAL_REFERRER // bonus for inviting a friend who redeemed your code
  REFERRAL_REDEEMED // bonus for redeeming someone else's invite code
  ADJUSTMENT // operator / promotional credit
}

/// Append-only ledger of every NON-TRADING credit to a wallet (referral
/// bonuses, promotional top-ups). Trading P&L never lands here. Returns are
/// measured on trading performance only, so room and leaderboard maths
/// subtract the credits that arrived after the point they measure from —
/// a referral bonus grows the balance but never the "winning %".
model WalletCredit {
  id        String           @id @default(cuid())
  userId    String
  kind      WalletCreditKind
  amountP   BigInt
  note      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_credits")
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  symbol        String
  tradingsymbol String
  symboltoken   String
  exchange      String
  side          OrderSide
  type          OrderType    @default(MARKET)
  product       OrderProduct @default(DELIVERY)
  origin        OrderOrigin  @default(USER)
  quantity      Int
  limitPriceP   BigInt?
  triggerPriceP BigInt?
  trailAmountP  BigInt?     // immutable distance for TRAILING_STOP
  fillPriceP    BigInt?
  feesP         BigInt      @default(0) // total brokerage + taxes + charges at fill time
  shortIntent   Boolean     @default(false) // SELL triggered orders that open a F&O short
  reservedMarginP BigInt    @default(0) // margin locked by this pending short-open order
  /// BUY of a futures contract on margin (SPAN-style): only the initial
  /// margin is blocked, not the full contract value.
  leveraged     Boolean     @default(false)
  /// Exact cash this pending BUY holds in wallet.reservedP (notional or
  /// margin, plus a fee buffer). 0 on orders placed before this column
  /// existed — those fall back to threshold × quantity.
  cashReservedP BigInt      @default(0)
  status        OrderStatus @default(PENDING)
  rejectReason  String?
  createdAt     DateTime    @default(now())
  filledAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("orders")
}

/// One row per user per trading-day-close. Written by the daily-snapshot
/// cron at midnight IST. Backs equity curves, the calendar heatmap, period
/// leaderboards (weekly / monthly), risk metrics (max drawdown, Sharpe),
/// and any other "compare this user's equity to a past point" UI.
model PortfolioSnapshot {
  id              String   @id @default(cuid())
  userId          String
  /// Local IST date (truncated to midnight) the snapshot represents. We
  /// store this as a DateTime for sortability; only the date portion is
  /// meaningful.
  asOfDate        DateTime
  totalEquityP    BigInt
  investedP       BigInt
  realizedPnLP    BigInt
  unrealizedPnLP  BigInt
  balanceP        BigInt
  marginReservedP BigInt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asOfDate])
  @@index([userId, asOfDate])
  @@map("portfolio_snapshots")
}

model LeaderboardEntry {
  userId       String   @id
  rank         Int
  displayName  String?
  totalEquityP BigInt
  returnPct    Float
  computedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rank])
  @@map("leaderboard_entries")
}

model Position {
  id            String       @id @default(cuid())
  userId        String
  symbol        String
  tradingsymbol String
  symboltoken   String
  exchange      String
  product       OrderProduct @default(DELIVERY)
  quantity      Int // signed: positive = long, negative = short
  reservedQty   Int          @default(0) // qty locked by PENDING sell orders
  avgPriceP     BigInt
  marginP       BigInt       @default(0) // margin blocked for this position (shorts, or leveraged futures longs)
  /// Futures long held on margin: the wallet only blocked marginP, so the
  /// position contributes its mark-to-market P&L (not its full contract
  /// value) to equity. False for cash equity, options, and legacy rows.
  leveraged     Boolean      @default(false)
  realizedPnLP  BigInt       @default(0)
  openedAt      DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symboltoken, exchange, product])
  @@index([userId])
  @@map("positions")
}

/// Multiplayer trading room. The room itself doesn't hold balances or
/// trades — every member trades with their existing global wallet/
/// positions. A [RoomMember.baselineEquityP] snapshot at join-time lets
/// us compute "return since joining" per member without rewriting the
/// trading stack to be room-scoped.
///
/// Tournament mode (isTournament = true) adds optional [startsAt] /
/// [endsAt] bounds. The leaderboard freezes at endsAt; new joiners are
/// rejected after a tournament starts so the ladder stays fair.
model Room {
  id          String   @id @default(cuid())
  /// 6-character invite code (uppercase A-Z + 2-9, ambiguous chars
  /// removed). Shared verbatim — joining flows hit /rooms/join/:code.
  code        String   @unique
  name        String
  description String?
  ownerId     String
  isPublic    Boolean  @default(false)
  isTournament Boolean @default(false)
  /// Tournament window. Null for evergreen rooms; both required when
  /// isTournament is true. Stored as full timestamps so we can show
  /// IST-localized start/end on the client without ambiguity.
  startsAt    DateTime?
  endsAt      DateTime?
  /// Soft cap. The service enforces this on join; UI shows X/Y members.
  /// 0 = unlimited.
  maxMembers  Int      @default(0)
  /// Tournament lifecycle stamps, set by RoomsLifecycleService. At startsAt
  /// every member is re-baselined so the race is measured from the bell, not
  /// from whenever each member happened to join; at endsAt every member's
  /// equity is captured so the final ranking can no longer move.
  startedAt   DateTime?
  finalizedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User         @relation("RoomOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members RoomMember[]

  @@index([ownerId])
  @@index([isPublic, isTournament])
  @@map("rooms")
}

/// One row per (user, room) pair the user has joined. The
/// [baselineEquityP] is the totalEquity snapshot taken at [baselineAt]
/// (join time, or the tournament start). Return % is trading-only:
///   (equity − baseline − wallet credits since baselineAt) / baseline
/// so a referral bonus that lands mid-room grows the balance but never the
/// ranking. Fair across members who joined at different times.
model RoomMember {
  id               String   @id @default(cuid())
  roomId           String
  userId           String
  baselineEquityP  BigInt
  /// When [baselineEquityP] was captured. Credits after this are excluded.
  baselineAt       DateTime @default(now())
  /// Equity captured when a tournament ended (null until finalized).
  finalEquityP     BigInt?
  /// Wallet credits between baselineAt and the tournament end, captured with
  /// [finalEquityP] so the frozen return stays trading-only.
  finalCreditsP    BigInt?
  joinedAt         DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
  @@map("room_members")
}

/// A badge a user has permanently unlocked. The badge *catalog* (id, name,
/// hint, icon, colour) lives in code on both the client and server; this
/// table stores only the per-user unlock event, so the server is the source
/// of truth for "what's earned" — anti-spoof, survives reinstall, and the
/// same across devices. [badgeId] matches the code catalog id (e.g.
/// 'first_trade'). Re-evaluation is idempotent via the unique constraint.
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_achievements")
}

/// One row per (user, lesson) the user has completed in the Trading Academy.
/// Lesson *content* lives in code (mobile); this is just the completion
/// record, so progress is server-authoritative, syncs across devices, and
/// can drive learning achievements. [lessonId] matches the code lesson id
/// (e.g. 'candles').
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

/// One row per end-of-lesson quiz attempt. Full history is kept (retakes are
/// allowed) so we can show a best score and power the 'quiz ace' achievement.
/// [score]/[total] are question counts, not money. [passed] is score == total.
model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  score       Int
  total       Int
  passed      Boolean
  attemptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@map("quiz_attempts")
}

/// Singleton settings for the marketing website (stockvirtue.com), edited from
/// the website's admin panel. Separate concern from the app — holds public site
/// metadata, social links, and raw HTML "code injection" blocks for site /
/// domain verification and analytics. Exactly one row (id = "singleton").
model SiteSetting {
  id              String   @id @default("singleton")
  siteTitle       String   @default("")
  siteDescription String   @default("") @db.Text
  contactEmail    String   @default("")
  playStoreUrl    String   @default("")
  /// { twitter, instagram, linkedin, youtube, facebook }
  social          Json     @default("{}")
  headCode        String   @default("") @db.Text
  bodyStartCode   String   @default("") @db.Text
  bodyEndCode     String   @default("") @db.Text
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

/// A contact-form submission from the marketing website. Persisted so the
/// admin panel can show every query even if the notification email fails, and
/// so operators can triage (status) and reply.
model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  reply     String?       @db.Text
  repliedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─── Newsroom: staff, roles & permissions ───────────────────────────────────
//
// Staff are ordinary [User] accounts — one identity across the app, the
// website and the newsroom portal — with a StaffProfile and one or more roles
// on top. Newsroom tables use UUID ids; keys into the older cuid tables stay
// text.

enum StaffStatus {
  ACTIVE
  SUSPENDED
}

/// A newsroom staff member. Created when a user is first granted a role;
/// suspending it ends every portal session at once.
model StaffProfile {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @unique
  displayName       String
  title             String?
  status            StaffStatus @default(ACTIVE)
  suspendedAt       DateTime?
  suspendedReason   String?
  lastPortalLoginAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        StaffSession[]
  loginChallenges StaffLoginChallenge[]
  author          NewsAuthor?
  createdArticles NewsArticle[]         @relation("ArticleCreatedBy")
  versions        NewsVersion[]
  reviews         NewsReview[]
  assignments     NewsAssignment[]      @relation("AssignmentAssignee")
  assignedByMe    NewsAssignment[]      @relation("AssignmentAssigner")
  comments        NewsComment[]
  uploads         MediaAsset[]
  handledItems    NewsSourceItem[]      @relation("ItemHandledBy")
  aiJobs          AiJob[]               @relation("AiJobRequestedBy")

  @@index([status])
  @@map("staff_profiles")
}

/// A named bundle of permissions. The ten default roles are system roles,
/// seeded and kept in sync from code (rbac/rbac.catalog.ts); admins can add
/// custom roles alongside them.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// One granular capability, e.g. `news.publish`. The catalogue lives in code
/// and is synced on boot, so a deploy can add permissions without a migration.
model Permission {
  key         String @id
  group       String
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String @db.Uuid
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// A role granted to a user. A role that is still assigned can't be deleted.
model UserRole {
  userId      String
  roleId      String   @db.Uuid
  grantedById String?
  grantedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// A signed-in newsroom portal session. The portal holds an opaque random
/// token; only its SHA-256 is stored, so a database leak can't be replayed.
model StaffSession {
  id            String    @id @default(uuid()) @db.Uuid
  staffId       String    @db.Uuid
  tokenHash     String    @unique
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, revokedAt])
  @@index([expiresAt])
  @@map("staff_sessions")
}

enum StaffChallengeStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

/// The second sign-in step: a one-time code emailed after the password check.
/// Only a keyed hash of the code is stored.
model StaffLoginChallenge {
  id         String               @id @default(uuid()) @db.Uuid
  staffId    String               @db.Uuid
  codeHash   String
  attempts   Int                  @default(0)
  resends    Int                  @default(0)
  status     StaffChallengeStatus @default(PENDING)
  ip         String?
  userAgent  String?
  createdAt  DateTime             @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@index([expiresAt])
  @@map("staff_login_challenges")
}

/// An invitation to join the newsroom with the given roles. The emailed link
/// carries a random token; only its SHA-256 is stored.
model StaffInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  email          String
  roleKeys       String[]
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("staff_invitations")
}

/// Append-only record of every privileged newsroom action. Never updated or
/// deleted; actor and entity ids are plain text so history survives deletes.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  meta        Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Newsroom: editorial content ────────────────────────────────────────────

enum NewsStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  CANCELLED
  ARCHIVED
}

model NewsCategory {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String   @default("")
  parentId    String?  @db.Uuid
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  seo         Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent         NewsCategory?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       NewsCategory[]   @relation("CategoryTree")
  articles       NewsArticle[]
  sources        NewsSource[]
  suggestedItems NewsSourceItem[] @relation("ItemSuggestedCategory")

  @@index([parentId, position])
  @@map("news_categories")
}

model NewsTag {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  articles NewsArticleTag[]

  @@map("news_tags")
}

/// Public byline. Usually a staff member, but outside contributors get one too.
model NewsAuthor {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  bio       String   @default("")
  avatarUrl String?
  socials   Json     @default("{}")
  staffId   String?  @unique @db.Uuid
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff    StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  articles NewsArticle[]

  @@map("news_authors")
}

enum MediaStatus {
  PENDING
  READY
  DELETED
}

/// An uploaded image or file in object storage. PENDING until the upload is
/// confirmed and checked; only READY assets can be used in articles.
model MediaAsset {
  id           String      @id @default(uuid()) @db.Uuid
  storageKey   String      @unique
  originalName String?
  mimeType     String
  bytes        Int
  width        Int?
  height       Int?
  sha256       String?
  alt          String      @default("")
  caption      String?
  credit       String?
  variants     Json        @default("{}")
  status       MediaStatus @default(PENDING)
  uploadedById String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  uploadedBy         StaffProfile? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  featuredInArticles NewsArticle[]

  @@index([status, createdAt])
  @@map("media_assets")
}

model NewsArticle {
  id                   String     @id @default(uuid()) @db.Uuid
  slug                 String     @unique
  title                String
  subtitle             String?
  summary              String     @default("") @db.Text
  /// Rich-text document (TipTap/ProseMirror JSON), validated against the
  /// allowed node schema before every save.
  content              Json       @default("{}")
  /// Sanitised HTML rendered from `content`, the only HTML ever served.
  contentHtml          String     @default("") @db.Text
  /// Plain text of `content`, for search and reading time.
  contentText          String     @default("") @db.Text
  status               NewsStatus @default(DRAFT)
  categoryId           String?    @db.Uuid
  authorId             String?    @db.Uuid
  createdById          String?    @db.Uuid
  featuredImageId      String?    @db.Uuid
  featuredImageCaption String?
  /// Sector names the story is about ("Banking", "IT").
  sectors              String[]   @default([])
  isFeatured           Boolean    @default(false)
  isBreaking           Boolean    @default(false)
  isAiGenerated        Boolean    @default(false)
  readingMinutes       Int        @default(1)
  /// { title, description, canonicalUrl, noIndex, noFollow, ogImageId }
  seo                  Json       @default("{}")
  /// [{ name, url, publishedAt, licence }]
  sourceAttribution    Json       @default("[]")
  editorialNotes       String?    @db.Text
  correctionNote       String?    @db.Text
  retractedAt          DateTime?
  retractionNote       String?    @db.Text
  version              Int        @default(1)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  firstPublishedAt     DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  category      NewsCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author        NewsAuthor?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdBy     StaffProfile?        @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  featuredImage MediaAsset?          @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  tags          NewsArticleTag[]
  versions      NewsVersion[]
  reviews       NewsReview[]
  assignments   NewsAssignment[]
  comments      NewsComment[]
  stocks        NewsArticleStock[]
  related       NewsRelatedArticle[] @relation("RelatedFrom")
  relatedBy     NewsRelatedArticle[] @relation("RelatedTo")
  dailyStats    NewsDailyStat[]
  widgets       NewsWidgetInstance[]
  sourceItems   NewsSourceItem[]     @relation("ItemArticle")
  repeatedBy    NewsSourceItem[]     @relation("ItemDuplicateOfArticle")
  aiJobs        AiJob[]

  /// Full-text search document. A STORED generated column (headline weight A,
  /// standfirst + summary B, body text C) that Postgres keeps up to date; the
  /// app only reads it. The default below mirrors the generation expression
  /// from the news_public_site migration so `migrate diff` sees no drift.
  searchVector Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, ((COALESCE(subtitle, ''::text) || ' '::text) || COALESCE(summary, ''::text))), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(\"contentText\", ''::text)), 'C'::\"char\"))"))

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([authorId, status, publishedAt(sort: Desc)])
  @@index([createdById, status])
  @@index([status, scheduledAt])
  @@index([searchVector], type: Gin)
  @@map("news_articles")
}

enum NewsVersionReason {
  AUTOSAVE
  MANUAL
  SUBMIT
  APPROVE
  PUBLISH
  CORRECTION
  RESTORE
}

/// A full snapshot of an article at a meaningful moment; revision comparison
/// diffs two of these.
model NewsVersion {
  id        String            @id @default(uuid()) @db.Uuid
  articleId String            @db.Uuid
  version   Int
  reason    NewsVersionReason
  snapshot  Json
  editorId  String?           @db.Uuid
  createdAt DateTime          @default(now())

  article NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor  StaffProfile? @relation(fields: [editorId], references: [id], onDelete: SetNull)

  @@unique([articleId, version])
  @@map("news_versions")
}

model NewsArticleTag {
  articleId String @db.Uuid
  tagId     String @db.Uuid

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("news_article_tags")
}

enum NewsAssignmentRole {
  WRITER
  EDITOR
  REVIEWER
}

enum NewsAssignmentStatus {
  OPEN
  DONE
  CANCELLED
}

model NewsAssignment {
  id           String               @id @default(uuid()) @db.Uuid
  articleId    String               @db.Uuid
  assigneeId   String               @db.Uuid
  role         NewsAssignmentRole
  status       NewsAssignmentStatus @default(OPEN)
  note         String?
  dueAt        DateTime?
  assignedById String?              @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  article    NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  assignee   StaffProfile  @relation("AssignmentAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  assignedBy StaffProfile? @relation("AssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([articleId])
  @@map("news_assignments")
}

enum NewsReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model NewsReview {
  id         String             @id @default(uuid()) @db.Uuid
  articleId  String             @db.Uuid
  version    Int
  reviewerId String?            @db.Uuid
  decision   NewsReviewDecision
  comment    String?            @db.Text
  createdAt  DateTime           @default(now())

  article  NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer StaffProfile? @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@map("news_reviews")
}

/// Editorial discussion on an article, optionally anchored to one block.
/// Public reader comments are a separate, later feature.
model NewsComment {
  id           String    @id @default(uuid()) @db.Uuid
  articleId    String    @db.Uuid
  authorId     String?   @db.Uuid
  parentId     String?   @db.Uuid
  blockId      String?
  body         String    @db.Text
  resolvedAt   DateTime?
  resolvedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  article NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  StaffProfile? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  NewsComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies NewsComment[] @relation("CommentThread")

  @@index([articleId, createdAt])
  @@map("news_comments")
}

/// A stock the article is about, keyed into the existing scrip master by
/// exchange + symbol (no duplicate instrument table).
model NewsArticleStock {
  articleId String  @db.Uuid
  exchange  String
  symbol    String
  isPrimary Boolean @default(false)

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, exchange, symbol])
  @@index([exchange, symbol])
  @@map("news_article_stocks")
}

model NewsRelatedArticle {
  articleId String @db.Uuid
  relatedId String @db.Uuid
  position  Int    @default(0)

  article NewsArticle @relation("RelatedFrom", fields: [articleId], references: [id], onDelete: Cascade)
  related NewsArticle @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([articleId, relatedId])
  @@map("news_related_articles")
}

/// Reader views per article per day (IST), from de-duplicated page views. No
/// reader identity is stored, so "Trending" needs no personal data.
model NewsDailyStat {
  articleId String   @db.Uuid
  day       DateTime @db.Date
  views     Int      @default(0)

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, day])
  @@index([day])
  @@map("news_daily_stats")
}

// ─── Website configuration ──────────────────────────────────────────────────

/// Versioned website configuration sections edited in the portal, one row per
/// section (e.g. `news.homepage`). Values are JSON checked against a schema in
/// code before every save; their history lives in the audit log.
model SiteConfig {
  key         String   @id
  value       Json
  version     Int      @default(1)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  @@map("site_config")
}

// ─── Market display: the ticker and article widgets ─────────────────────────
//
// Separate from trading: these tables only decide which instruments the
// website and app may show, under which data licence, and remember the last
// price shown. Prices themselves come from the API's existing broker feed.

enum MarketDataRight {
  LIVE
  DELAYED
  EOD
  OFF
}

enum MarketInstrumentKind {
  INDEX
  STOCK
  COMMODITY
  CURRENCY
}

/// A market-data provider and what we may show from it, per channel. The
/// website and the app are licensed separately: DELAYED shows prices from
/// `delayMinutes` ago, EOD the last close, OFF nothing.
model MarketDataSource {
  key          String          @id
  name         String
  webRight     MarketDataRight @default(LIVE)
  appRight     MarketDataRight @default(LIVE)
  delayMinutes Int             @default(15)
  attribution  String          @default("")
  updatedById  String?         @db.Uuid
  updatedAt    DateTime        @updatedAt

  instruments MarketInstrument[]

  @@map("market_data_sources")
}

/// The curated instruments the ticker and market widgets may show. Capped in
/// code, so the public market API can never become an open price feed.
model MarketInstrument {
  id        String               @id @default(uuid()) @db.Uuid
  sourceKey String               @default("angel-one")
  kind      MarketInstrumentKind
  exchange  String
  /// Scrip-master lookup key: NIFTY, NIFTY IT, RELIANCE, GOLD, USDINR.
  symbol    String
  name      String
  /// Quote unit for commodities and currencies ("10 g").
  unit      String?
  position  Int                  @default(0)
  isEnabled Boolean              @default(true)
  inTicker  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  source MarketDataSource @relation(fields: [sourceKey], references: [key])
  quote  MarketQuote?

  @@unique([exchange, symbol])
  @@index([isEnabled, position])
  @@map("market_instruments")
}

/// Last known price of a curated instrument, so it survives restarts and can
/// still be shown, as end-of-day, while the live feed is down.
model MarketQuote {
  instrumentId String   @id @db.Uuid
  ltp          Float
  open         Float
  high         Float
  low          Float
  prevClose    Float
  change       Float
  changePct    Float
  volume       Float    @default(0)
  /// When the exchange last moved the price.
  asOf         DateTime
  updatedAt    DateTime @updatedAt

  instrument MarketInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@map("market_quotes")
}

/// A saved, reusable widget. Articles embed it by reference, so editing it
/// updates every story that uses it.
model MarketWidget {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  type        String
  version     Int
  config      Json
  /// EX:SYMBOL references the widget quotes, for the public quote allowlist.
  symbols     String[] @default([])
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  instances NewsWidgetInstance[]

  @@index([type])
  @@index([symbols], type: Gin)
  @@map("market_widgets")
}

/// The widgets in each article, rebuilt on every save: usage counts for saved
/// widgets, and the stocks published stories are allowed to quote.
model NewsWidgetInstance {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @db.Uuid
  position  Int
  type      String
  version   Int
  widgetId  String?  @db.Uuid
  symbols   String[] @default([])

  article NewsArticle   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  widget  MarketWidget? @relation(fields: [widgetId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([widgetId])
  @@index([symbols], type: Gin)
  @@map("news_widget_instances")
}

// ─── Newsroom: news ingestion ───────────────────────────────────────────────
//
// Sources the worker polls (feeds, licensed APIs, exchange / RBI / SEBI /
// government announcements) and the items they deliver. Items wait in the
// portal's Incoming list for a person: nothing here is ever published, and a
// story started from an item goes through the normal review workflow.

enum NewsSourceType {
  RSS
  LICENSED_API
  EXCHANGE
  COMPANY_IR
  RBI
  SEBI
  GOVERNMENT
  MANUAL
}

/// How a source is read: a feed (RSS, Atom or RDF, detected), a JSON API
/// through a field mapping, or not at all (manual submissions).
enum NewsSourceFormat {
  FEED
  JSON_API
  NONE
}

/// What the source's terms let the newsroom keep and reuse.
enum NewsSourceUsage {
  /// Headline and link only.
  HEADLINE_ONLY
  /// Headline, link and the source's own summary.
  SUMMARY
  /// Licensed full text.
  FULL_TEXT
}

enum NewsItemStatus {
  NEW
  DRAFTED
  DISMISSED
  DUPLICATE
}

enum NewsFetchStatus {
  RUNNING
  SUCCESS
  NOT_MODIFIED
  FAILED
}

enum NewsFetchTrigger {
  SCHEDULE
  MANUAL
  RETRY
}

model NewsSource {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String
  type                NewsSourceType
  format              NewsSourceFormat
  /// Feed or API address (none for manual submissions).
  url                 String?
  /// { mode: "header" | "query", name }: where the secret goes on a request.
  auth                Json             @default("{}")
  /// API key or token, sealed with NEWSROOM_SECRETS_KEY (common/secret-box.ts).
  /// Never returned to any client.
  secret              String?
  /// JSON APIs: { itemsPath, fields: { title, url, id, publishedAt, summary, content, author } }.
  mapping             Json             @default("{}")
  pollMinutes         Int              @default(30)
  isActive            Boolean          @default(true)
  /// Default category for stories started from this source.
  categoryId          String?          @db.Uuid
  usage               NewsSourceUsage  @default(HEADLINE_ONLY)
  /// Whether the source's terms allow AI-assisted drafts from its items.
  allowAiDrafts       Boolean          @default(false)
  /// Credit shown on stories, e.g. "Reserve Bank of India".
  attribution         String           @default("")
  licenceNote         String?          @db.Text
  /// Email editors when new items arrive.
  notifyEditors       Boolean          @default(false)
  etag                String?
  lastModified        String?
  nextPollAt          DateTime?
  lastFetchedAt       DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastError           String?
  consecutiveFailures Int              @default(0)
  createdById         String?          @db.Uuid
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  category  NewsCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items     NewsSourceItem[]
  fetchLogs NewsFetchLog[]

  @@index([isActive, nextPollAt])
  @@map("news_sources")
}

model NewsSourceItem {
  id                   String          @id @default(uuid()) @db.Uuid
  sourceId             String          @db.Uuid
  /// SHA-256 of the item's id in its source (guid, else link, else headline
  /// and time): each item is stored once per source.
  externalHash         String
  /// The original story, without tracking parameters.
  url                  String?
  /// SHA-256 of `url`: the same story arriving from another source.
  urlHash              String?
  title                String
  /// Normalised headline words, for duplicate checks.
  titleKey             String
  /// The source's own summary, kept only when its terms allow (SUMMARY, FULL_TEXT).
  summary              String?         @db.Text
  /// Full text, from licensed (FULL_TEXT) sources only.
  content              String?         @db.Text
  author               String?
  /// When the source says it published the story.
  publishedAt          DateTime?
  fetchedAt            DateTime        @default(now())
  /// The source's terms when the item arrived; later changes don't widen them.
  usage                NewsSourceUsage
  allowAiDrafts        Boolean         @default(false)
  attribution          String          @default("")
  /// Categories or keywords from the source itself.
  feedCategories       String[]        @default([])
  /// Listed companies found in the item: [{ exchange, symbol, name, via }].
  stocks               Json            @default("[]")
  /// "NSE:INFY" refs of `stocks`, for filtering.
  stockRefs            String[]        @default([])
  /// Topics from the classifier ("ipo", "results", "policy", …).
  topics               String[]        @default([])
  suggestedCategoryId  String?         @db.Uuid
  status               NewsItemStatus  @default(NEW)
  /// The earlier item (or story) this one repeats. With status DUPLICATE it
  /// is a confirmed repeat; on a NEW item it is a possible one.
  duplicateOfId        String?         @db.Uuid
  duplicateOfArticleId String?         @db.Uuid
  /// Headline similarity to it (1 = same link or headline).
  duplicateScore       Float?
  /// The story started from this item.
  articleId            String?         @db.Uuid
  handledById          String?         @db.Uuid
  handledAt            DateTime?

  source             NewsSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  suggestedCategory  NewsCategory?    @relation("ItemSuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  duplicateOf        NewsSourceItem?  @relation("ItemDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         NewsSourceItem[] @relation("ItemDuplicates")
  duplicateOfArticle NewsArticle?     @relation("ItemDuplicateOfArticle", fields: [duplicateOfArticleId], references: [id], onDelete: SetNull)
  article            NewsArticle?     @relation("ItemArticle", fields: [articleId], references: [id], onDelete: SetNull)
  handledBy          StaffProfile?    @relation("ItemHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  aiJobs             AiJob[]

  @@unique([sourceId, externalHash])
  @@index([status, fetchedAt(sort: Desc)])
  @@index([sourceId, fetchedAt(sort: Desc)])
  @@index([urlHash])
  @@index([titleKey])
  @@index([fetchedAt])
  @@index([articleId])
  @@index([stockRefs], type: Gin)
  @@map("news_source_items")
}

/// One fetch of one source: when, how it went, and what it found.
model NewsFetchLog {
  id             String           @id @default(uuid()) @db.Uuid
  sourceId       String           @db.Uuid
  trigger        NewsFetchTrigger
  status         NewsFetchStatus  @default(RUNNING)
  /// Who pressed Fetch now or Retry (display name).
  requestedBy    String?
  retryOfId      String?          @db.Uuid
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  httpStatus     Int?
  itemsSeen      Int              @default(0)
  itemsNew       Int              @default(0)
  itemsDuplicate Int              @default(0)
  error          String?          @db.Text

  source  NewsSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  retryOf NewsFetchLog?  @relation("FetchRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries NewsFetchLog[] @relation("FetchRetries")

  @@index([sourceId, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("news_fetch_logs")
}

/// Stock mapping: phrases the matcher maps to a listed company (an alias such
/// as "RIL"), or never treats as a company (exchange and symbol null).
model NewsStockAlias {
  id        String   @id @default(uuid()) @db.Uuid
  /// Normalised phrase, e.g. "ril" or "l and t".
  alias     String   @unique
  /// What staff typed, for display.
  label     String
  exchange  String?
  symbol    String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  @@map("news_stock_aliases")
}

// ─── Newsroom: AI assistant ─────────────────────────────────────────────────
//
// Provider-independent and off until a Super Admin sets it up. AI only ever
// returns drafts and suggestions to a person; nothing it writes is published
// without the normal editorial review.

enum AiProviderKind {
  ANTHROPIC
  OPENAI
  OPENAI_COMPATIBLE
  OLLAMA
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AiTask {
  DRAFT_FROM_SOURCE
  DRAFT_FROM_NOTES
  HEADLINES
  SUMMARY
  SEO
  TAXONOMY
  RELATED_STOCKS
  RELATED_ARTICLES
  REVIEW
  EXPLAINERS
  REWRITE_SECTION
}

model AiProvider {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  kind              AiProviderKind
  /// API address. Blank = the provider's own; required for compatible servers and Ollama.
  baseUrl           String?
  model             String
  /// Sealed API key (common/secret-box.ts). Never returned to any client.
  apiKey            String?
  /// US dollars per million tokens, for cost estimates.
  inputCostPerMTok  Float?
  outputCostPerMTok Float?
  timeoutSeconds    Int            @default(120)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  jobs     AiJob[]
  settings AiSettings[]

  @@map("ai_providers")
}

/// One row (id "default"): the newsroom's AI switch, provider and limits.
model AiSettings {
  id               String   @id @default("default")
  enabled          Boolean  @default(false)
  providerId       String?  @db.Uuid
  /// Draft automatically when a source that allows AI drafts delivers an item.
  autoDraft        Boolean  @default(false)
  /// AiTask names staff may not run.
  disabledTasks    String[] @default([])
  monthlyBudgetUsd Float?
  dailyJobsPerUser Int      @default(60)
  version          Int      @default(1)
  updatedBy        String?
  updatedAt        DateTime @updatedAt

  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("ai_settings")
}

/// Every AI request: what was asked, what came back, the automatic checks,
/// tokens and cost. The assistant's processing history.
model AiJob {
  id            String      @id @default(uuid()) @db.Uuid
  task          AiTask
  status        AiJobStatus @default(QUEUED)
  providerId    String?     @db.Uuid
  /// Provider kind and model that ran it, kept if the provider is removed.
  providerKind  String?
  model         String?
  promptId      String
  promptVersion Int
  input         Json
  output        Json?
  /// Automatic checks on the output: { removed, unverified, copied }.
  checks        Json?
  error         String?     @db.Text
  inputTokens   Int?
  outputTokens  Int?
  costUsd       Float?
  durationMs    Int?
  /// null = started automatically (a source item).
  requestedById String?     @db.Uuid
  articleId     String?     @db.Uuid
  sourceItemId  String?     @db.Uuid
  appliedAt     DateTime?
  appliedById   String?     @db.Uuid
  createdAt     DateTime    @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  provider    AiProvider?     @relation(fields: [providerId], references: [id], onDelete: SetNull)
  requestedBy StaffProfile?   @relation("AiJobRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  article     NewsArticle?    @relation(fields: [articleId], references: [id], onDelete: SetNull)
  sourceItem  NewsSourceItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([articleId, createdAt(sort: Desc)])
  @@index([sourceItemId, createdAt(sort: Desc)])
  @@index([requestedById, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("ai_jobs")
}
