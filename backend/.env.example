# ────────────────────────────────────────────────────────────────
# StockVirtue backend — copy to .env and fill with real values.
# DO NOT COMMIT .env. In production, inject these via your platform's
# secret store, not a file. Vars marked [PROD-REQUIRED] make the app
# refuse to boot when NODE_ENV=production and they're blank.
# ────────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public origin the admin dashboard is served from, behind a reverse proxy
# (e.g. https://api.stockvirtue.com). OPTIONAL — only needed if your proxy
# rewrites Host to a non-localhost value and doesn't forward X-Forwarded-Host;
# it lets the admin same-site/CSRF check recognise legitimate form POSTs.
# PUBLIC_URL=https://api.stockvirtue.com

# PostgreSQL (matches docker-compose at repo root)
DATABASE_URL=postgresql://stockvirtue:change_me@localhost:5432/stockvirtue

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Angel One SmartAPI (live market data). Treat the TOTP secret + PIN as
# real-account credentials — store only in a secret manager.
SMARTAPI_KEY=
SMARTAPI_SECRET=
SMARTAPI_CLIENT_CODE=
SMARTAPI_TOTP_SECRET=
SMARTAPI_PIN=

# JWT — generate fresh per environment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Firebase Admin (Google + Phone login, FCM push). [PROD-REQUIRED]
# FCM_SERVICE_ACCOUNT = the service-account JSON, MINIFIED onto one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=

# SMTP for transactional email (OTP, password reset). [PROD-REQUIRED]
# When blank in dev, OTPs are logged to the console (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StockVirtue <no-reply@stockvirtue.com>

# Backend admin dashboard (/admin). [PROD-REQUIRED] password (min 12, not the
# default) and a distinct session secret (min 32, NOT equal to a JWT secret).
ADMIN_EMAIL=admin@stockvirtue.local
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800

# ────────────────────────────────────────────────────────────────
# Public market feed — the /fincalc WebSocket namespace.
#
# Streams a FIXED set of 10 instruments (Nifty 50, Bank Nifty, Nifty
# Financial, Nifty Next 50, Sensex, BSE Bankex, Gold, Silver, Crude Oil,
# Natural Gas) to sibling apps. Carries no user data, and authenticates
# with its own keys — nothing here can reach a StockVirtue account.
# Ships OFF; set FEED_ENABLED=true to turn it on.
# ────────────────────────────────────────────────────────────────
FEED_ENABLED=false

# Comma-separated "clientId:secret" pairs — one per consuming app, so a
# single key can be revoked without disturbing the others. Generate with:
#   node -e "console.log('fincalc-app:'+require('crypto').randomBytes(32).toString('base64url'))"
FEED_API_KEYS=

# HMAC key for short-lived signed tokens. Strongly recommended for mobile:
# the raw key then lives only on FinCalc's server, never inside the shipped
# APK, and a leaked token expires on its own. Min 32 chars.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FEED_TOKEN_SECRET=
FEED_TOKEN_TTL=900

# Flip to true once FinCalc's server mints tokens — raw API keys are then
# refused outright.
FEED_REQUIRE_SIGNED_TOKENS=false

# Comma-separated browser origins allowed to connect. Empty = no Origin
# check (native apps send no Origin header, so they are unaffected).
FEED_ALLOWED_ORIGINS=

# Tuning. Ticks arrive far faster than the broadcast window and are
# coalesced into one frame per instrument per window.
FEED_BROADCAST_MS=1000
FEED_SNAPSHOT_REFRESH_MS=60000
FEED_UNIVERSE_REFRESH_MS=21600000
FEED_MAX_CONNECTIONS=5000
FEED_MAX_CONNECTIONS_PER_IP=20

# ─── Newsroom (staff portal, media, background worker) ─────────────────────
# Everything here is optional: a missing value never stops the trading API.

# HMAC key for emailed newsroom sign-in codes. Blank = derived from
# JWT_ACCESS_SECRET. Set your own (min 32 chars) to rotate it independently:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STAFF_AUTH_SECRET=
# A portal session ends after this many idle minutes, and after this many
# hours regardless.
STAFF_SESSION_IDLE_MINUTES=60
STAFF_SESSION_MAX_HOURS=12
# Lifetime of an emailed sign-in code (seconds) and of an invitation (hours).
STAFF_LOGIN_CODE_TTL=300
STAFF_INVITE_TTL_HOURS=72
# Public URL of the staff portal; invitation emails link to <this>/invite.
NEWSROOM_PORTAL_URL=https://stockvirtue.com/admin
# Shared secret with the website server (stockvirtue.com), which runs the
# portal. Required for the portal: only calls carrying it may pass on the staff
# member's real IP (rate limits, audit log). Same value as SITE_ADMIN_KEY in
# web/.env:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SITE_ADMIN_KEY=
# Where website contact-form messages are emailed (blank = ADMIN_EMAIL).
SITE_CONTACT_TO=

# Media storage: Cloudflare R2. "none" (default) disables uploads.
# R2: Cloudflare dashboard → R2 → create bucket → "Manage API tokens"
# (Object Read & Write on that bucket). MEDIA_PUBLIC_BASE_URL is the custom
# domain connected to the bucket (served through Cloudflare's CDN).
MEDIA_STORAGE_DRIVER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_MB=10

# Background jobs (BullMQ) share the Redis above under this key prefix.
# Run the worker as its own process:  pm2 start dist/worker.js --name stockvirtue-worker
QUEUE_PREFIX=sv
