# ────────────────────────────────────────────────────────────────
# StockVirtue backend — copy to .env and fill with real values.
# DO NOT COMMIT .env. In production, inject these via your platform's
# secret store, not a file. Vars marked [PROD-REQUIRED] make the app
# refuse to boot when NODE_ENV=production and they're blank.
# ────────────────────────────────────────────────────────────────

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public origin the admin dashboard is served from, behind a reverse proxy
# (e.g. https://api.stockvirtue.com). OPTIONAL — only needed if your proxy
# rewrites Host to a non-localhost value and doesn't forward X-Forwarded-Host;
# it lets the admin same-site/CSRF check recognise legitimate form POSTs.
# PUBLIC_URL=https://api.stockvirtue.com

# PostgreSQL (matches docker-compose at repo root)
DATABASE_URL=postgresql://stockvirtue:change_me@localhost:5432/stockvirtue

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Angel One SmartAPI (live market data). Treat the TOTP secret + PIN as
# real-account credentials — store only in a secret manager.
SMARTAPI_KEY=
SMARTAPI_SECRET=
SMARTAPI_CLIENT_CODE=
SMARTAPI_TOTP_SECRET=
SMARTAPI_PIN=

# JWT — generate fresh per environment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Firebase Admin (Google + Phone login, FCM push). [PROD-REQUIRED]
# FCM_SERVICE_ACCOUNT = the service-account JSON, MINIFIED onto one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT=

# SMTP for transactional email (OTP, password reset). [PROD-REQUIRED]
# When blank in dev, OTPs are logged to the console (never in production).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StockVirtue <no-reply@stockvirtue.com>

# Backend admin dashboard (/admin). [PROD-REQUIRED] password (min 12, not the
# default) and a distinct session secret (min 32, NOT equal to a JWT secret).
ADMIN_EMAIL=admin@stockvirtue.local
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=28800
